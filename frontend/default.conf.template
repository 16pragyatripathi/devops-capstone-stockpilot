# Rendered at container start by the nginx image (envsubst); BACKEND_URL comes from the environment.
# Runs as the unprivileged nginx user, so listen on 8080 rather than 80.
server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # Hashed build assets can be cached for a long time.
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  # index.html must always be revalidated, so a new deployment shows up on the next reload.
  location / {
    add_header Cache-Control "no-cache";
    try_files $uri /index.html;
  }

  # Docker Compose: "backend" is the Compose service name.
  # Kubernetes: the Ingress sends /api straight to the backend Service, and this
  # proxy is the fallback when the frontend Service is reached directly.
  location /api/ {
    proxy_pass ${BACKEND_URL};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location = /nginx-health {
    access_log off;
    return 200 "ok\n";
  }
}
