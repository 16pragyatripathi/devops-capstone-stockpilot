# Copy to terraform.tfvars and adjust. Never put AWS keys in this file:
# Terraform reads credentials from `aws configure` / environment variables.
aws_region          = "ap-south-1"
project             = "stockpilot"
environment         = "dev"
kubernetes_version  = "1.34"
node_instance_types = ["t3.medium"]
node_desired_size   = 2
github_repository   = "your-github-user/devops-capstone-stockpilot"
# create_github_oidc_provider = false   # if the account already has the GitHub OIDC provider
